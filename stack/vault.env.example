# =============================================================================
#  10-4 VAULT — per-deployment configuration
# =============================================================================
#  Copy to /srv/vault/vault.env, fill in, then: chmod 600 /srv/vault/vault.env
#  ONE of these files per client. Never commit a filled-in copy.
# =============================================================================

# --- Identity -----------------------------------------------------------------
# Short lowercase name for this deployment. Used in paths and snapshot tags.
VAULT_NAME=ryan

# Where all vault data lives. Should be the mount point of the big data disk.
VAULT_ROOT=/srv/vault

# Timezone (affects photo timestamps + backup scheduling)
TZ=America/New_York

# --- Tailscale ----------------------------------------------------------------
# Your tailnet domain, e.g. tail9a1b2.ts.net  (find it: tailscale status --json | grep MagicDNSSuffix)
TAILNET_DOMAIN=

# The tailscale hostname of THIS box (find it: tailscale status --self)
TS_HOSTNAME=vault

# Ports published on the tailnet. Immich on 443, Nextcloud on 8443.
IMMICH_HTTPS_PORT=443
NEXTCLOUD_HTTPS_PORT=8443

# --- Immich -------------------------------------------------------------------
# Postgres password. A-Za-z0-9 ONLY — special characters break Immich's DB URL.
# Generate: openssl rand -hex 24
DB_PASSWORD=

# Pin the Immich major version. "v3" tracks v3.x. Do not use "release" in
# production — an unattended major upgrade can require a manual migration.
IMMICH_VERSION=v3

# --- Nextcloud ----------------------------------------------------------------
# Generate: openssl rand -hex 24
NC_DB_PASSWORD=
NC_ADMIN_USER=admin
# Generate: openssl rand -base64 18
NC_ADMIN_PASSWORD=

# --- Backblaze B2 -------------------------------------------------------------
# From B2 -> Application Keys. Create a key scoped to THIS client's bucket only.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Bucket must already exist. Format: b2:BUCKETNAME:PATH
RESTIC_REPOSITORY=b2:ten4-vault-ryan:/

# =============================================================================
#  THE ONLY KEY. READ THIS.
# =============================================================================
#  This passphrase encrypts everything before it leaves the machine.
#  Backblaze cannot reset it. Ryan cannot reset it. Anthropic cannot reset it.
#  Lose this line and every off-site backup is permanently unreadable.
#
#  Generate: openssl rand -base64 32
#  Then WRITE IT ON PAPER and put it somewhere physical, before you continue.
# =============================================================================
RESTIC_PASSWORD=

# --- Retention ----------------------------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12
KEEP_YEARLY=3
