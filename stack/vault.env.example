# =============================================================================
#  10-4 VAULT — per-deployment configuration
# =============================================================================
#  Copy to /srv/vault/vault.env, fill in, then: chmod 600 /srv/vault/vault.env
#  ONE of these files per client. Never commit a filled-in copy.
# =============================================================================

# --- Identity -----------------------------------------------------------------
# Short lowercase name for this deployment. Used in paths and snapshot tags.
VAULT_NAME=ryan

# FAST tier — databases, dumps, config. Wants an SSD. Stays small: well under
# 200GB even for a very large library.
VAULT_ROOT=/srv/vault

# BULK tier — photo and video originals, iPhone device backups. This is the
# big disk. Leave BLANK to keep everything on VAULT_ROOT (correct for anything
# under a few TB).
#
# Above ~4TB, split them: consumer SSDs stop at 8TB and cost around $144/TB,
# while a 16TB hard drive is about $16/TB. Media is read sequentially, so the
# hard drive is indistinguishable in use. See docs/STORAGE.md.
VAULT_MEDIA=

# Timezone (affects photo timestamps + backup scheduling)
TZ=America/New_York

# --- Tailscale ----------------------------------------------------------------
# Your tailnet domain, e.g. tail9a1b2.ts.net  (find it: tailscale status --json | grep MagicDNSSuffix)
TAILNET_DOMAIN=

# The tailscale hostname of THIS box (find it: tailscale status --self)
TS_HOSTNAME=vault

# Ports published on the tailnet. Immich on 443, Nextcloud on 8443.
IMMICH_HTTPS_PORT=443
NEXTCLOUD_HTTPS_PORT=8443

# --- Immich -------------------------------------------------------------------
# Postgres password. A-Za-z0-9 ONLY — special characters break Immich's DB URL.
# Generate: openssl rand -hex 24
DB_PASSWORD=

# Pin the Immich major version. "v3" tracks v3.x. Do not use "release" in
# production — an unattended major upgrade can require a manual migration.
IMMICH_VERSION=v3

# --- Nextcloud ----------------------------------------------------------------
# Generate: openssl rand -hex 24
NC_DB_PASSWORD=
NC_ADMIN_USER=admin
# Generate: openssl rand -base64 18
NC_ADMIN_PASSWORD=

# --- Off-site destination -----------------------------------------------------
# Two supported options. See docs/COSTS.md for the money side.
#
#  A) Backblaze B2 — $6.95/TB/month, nothing to maintain.
#       RESTIC_REPOSITORY=b2:ten4-vault-ryan:/
#       B2_ACCOUNT_ID / B2_ACCOUNT_KEY required (scope the key to this bucket).
#
#  B) A second box somewhere else — a Pi and a drive at a relative's house,
#     reached over Tailscale. ~$180 once, then $0/month. Best value for a
#     large library, and B2 gets expensive above ~2TB.
#       RESTIC_REPOSITORY=sftp:vault-offsite:/mnt/backup/ryan
#       (leave the B2 lines blank; set up SSH keys to that host first)
#
#  Best of both: B2 for the irreplaceable core, and a second box for the bulk.
RESTIC_REPOSITORY=b2:ten4-vault-ryan:/
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# =============================================================================
#  THE ONLY KEY. READ THIS.
# =============================================================================
#  This passphrase encrypts everything before it leaves the machine.
#  Backblaze cannot reset it. Ryan cannot reset it. Anthropic cannot reset it.
#  Lose this line and every off-site backup is permanently unreadable.
#
#  Generate: openssl rand -base64 32
#  Then WRITE IT ON PAPER and put it somewhere physical, before you continue.
# =============================================================================
RESTIC_PASSWORD=

# --- What goes off-site -------------------------------------------------------
# iPhone device backups are big (often 50-150GB each) and they are the single
# largest line on your Backblaze bill. Set this to 0 to keep them on local disk
# only and leave them out of the off-site copy.
#
# The trade-off is real: they are re-creatable from the phone, but ONLY while
# the phone still exists. With this off, losing the house and the phone
# together loses your Messages, Notes and Health history. Photos, files,
# contacts and calendars are unaffected either way.
#
# Leave it at 1 unless the bill genuinely matters. See docs/COSTS.md.
BACKUP_IPHONE_OFFSITE=1

# --- Retention ----------------------------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12
KEEP_YEARLY=3
