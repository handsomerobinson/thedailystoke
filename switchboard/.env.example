# Telnyx
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxx
TELNYX_MESSAGING_PROFILE_ID=40000000-0000-0000-0000-000000000000
# Portal → Keys & Credentials → Public Key (base64). Leave empty ONLY for local testing.
TELNYX_PUBLIC_KEY=

# Switchboard
SWITCHBOARD_DB=switchboard.db
# fake = print/record sends instead of texting real phones
SWITCHBOARD_CARRIER=telnyx
# Python path to the brain factory, e.g. scout.adapter:make_brain  (default: dev brain)
SCOUT_BRAIN=scout_switchboard.brain:DevBrain
# Bearer token for /admin endpoints
SWITCHBOARD_ADMIN_TOKEN=change-me
# Text tenant admins when an unknown number texts in
NOTIFY_ADMINS_OF_UNKNOWN=true
